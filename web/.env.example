# true (default) = fake run from shared/fixtures (inkbirdJobSample.json for inkbird-01, jobSample.json otherwise), false = Pam's real backend
NEXT_PUBLIC_USE_MOCK=true
# true = start the sample job on page load (always on with the in-browser mock)
NEXT_PUBLIC_AUTO_START=false
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_DEVICE_ID=inkbird-01
# what Reject does (not agreed with Pam yet): abort | pause | replan. default pause
NEXT_PUBLIC_REJECT_BEHAVIOR=pause
# sent with every decision as decided_by
NEXT_PUBLIC_OPERATOR_NAME=operator
